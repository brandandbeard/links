<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>অতিক্রান্ত দূরত্ব ও সরণ | ইন্টারঅ্যাক্টিভ সিমুলেশন</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#070d1c; --card:#0f1830; --card2:#0c1426; --border:#1d2b4f;
  --text:#e8eeff; --muted:#9db0d8;
  --dist:#f59e0b; --disp:#22c55e;
}
*{margin:0;padding:0;box-sizing:border-box}
body{
  font-family:'Hind Siliguri',sans-serif;color:var(--text);min-height:100vh;
  background:
    radial-gradient(900px 500px at 85% -10%, rgba(245,158,11,.12), transparent 60%),
    radial-gradient(800px 500px at -10% 30%, rgba(34,197,94,.10), transparent 60%),
    var(--bg);
}
.wrap{max-width:1180px;margin:0 auto;padding:0 18px}
.hero{padding:48px 0 20px;text-align:center}
.emojis{font-size:22px;letter-spacing:8px;margin-bottom:10px}
.hero h1{font-size:clamp(28px,4.5vw,44px);font-weight:700}
.grad{background:linear-gradient(90deg,#f59e0b,#fbbf24,#4ade80,#22c55e);-webkit-background-clip:text;background-clip:text;color:transparent}
.sub{color:var(--muted);max-width:680px;margin:12px auto 0;font-size:16.5px;line-height:1.8}
.section-title{font-size:22px;font-weight:700;margin:38px 0 16px}
.defs{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px}
.def{background:var(--card);border:1px solid var(--border);border-top:4px solid var(--c);border-radius:16px;padding:18px 20px}
.def h3{color:var(--c);font-size:18px;margin-bottom:8px}
.def p{color:var(--muted);font-size:14.5px;line-height:1.8}
.def .tag{display:inline-block;margin-top:10px;font-size:12.5px;font-weight:700;color:var(--c);border:1px solid var(--c);border-radius:999px;padding:3px 12px;background:rgba(255,255,255,.03)}
.card{background:linear-gradient(180deg,var(--card),var(--card2));border:1px solid var(--border);border-radius:20px;padding:18px;box-shadow:0 12px 30px rgba(0,0,0,.28)}
.card h3{font-size:17.5px;margin-bottom:4px}
.card .hint{color:var(--muted);font-size:13.5px;margin-bottom:12px;line-height:1.7}
.canvas-wrap{border-radius:14px;overflow:hidden;border:1px solid var(--border);background:radial-gradient(120% 120% at 50% 0%,#101d3d 0%,#0a1226 70%)}
.canvas-wrap canvas{width:100%;display:block}
#cv1{height:330px} #cv2,#cv3{height:300px}
.legend{display:flex;gap:18px;flex-wrap:wrap;margin:12px 0 0;font-size:13.5px;color:var(--muted);font-weight:600}
.legend span{display:inline-flex;align-items:center;gap:7px}
.ld{width:14px;height:14px;border-radius:50%}
.sim-controls{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-top:14px}
.btn{font-family:inherit;font-size:14px;font-weight:600;color:#fff;border:none;border-radius:11px;padding:9px 16px;cursor:pointer;transition:.2s}
.btn:hover{filter:brightness(1.15)}
.btn-amber{background:linear-gradient(135deg,#f59e0b,#d97706)}
.btn-green{background:linear-gradient(135deg,#22c55e,#15803d)}
.btn-slate{background:#243352}
.slider-box{display:flex;align-items:center;gap:10px;color:var(--muted);font-weight:600;font-size:14px}
.slider-box input{width:160px;accent-color:#f59e0b;cursor:pointer}
.readouts{display:flex;gap:14px;flex-wrap:wrap;margin-top:14px}
.readout{flex:1;min-width:160px;background:#0b1226;border:1px solid var(--border);border-radius:12px;padding:12px 16px}
.readout .lab{font-size:13px;color:var(--muted);font-weight:600}
.readout .val{font-size:24px;font-weight:700;margin-top:2px}
.val.amber{color:#fbbf24}.val.green{color:#4ade80}
.bar{height:7px;border-radius:99px;background:#1a2747;margin-top:9px;overflow:hidden}
.bar>div{height:100%;border-radius:99px;width:0%}
.bar .fa{background:linear-gradient(90deg,#b45309,#fbbf24)}
.bar .fg{background:linear-gradient(90deg,#15803d,#4ade80)}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:22px;margin-top:22px}
table{width:100%;border-collapse:collapse;min-width:600px}
.th-card{background:var(--card);border:1px solid var(--border);border-radius:18px;overflow:hidden;overflow-x:auto}
th,td{padding:13px 18px;text-align:left;font-size:14.5px;border-bottom:1px solid var(--border);vertical-align:top;line-height:1.7}
th{background:rgba(56,189,248,.07);color:#7dd3fc;font-size:13.5px}
tr:last-child td{border-bottom:none}
td.c1{color:#fbbf24;font-weight:600} td.c2{color:#4ade80;font-weight:600}
.tips{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px;margin-top:16px}
.tip{border:1px dashed #3b4a6b;border-radius:14px;padding:14px 18px;font-size:14.5px;color:var(--muted);line-height:1.8;background:rgba(255,255,255,.02)}
.tip b{color:var(--text)}
footer{text-align:center;color:#5b6c93;font-size:13.5px;padding:34px 0 42px;line-height:1.9}
</style>
</head>
<body>

<header class="hero">
  <div class="wrap">
    <div class="emojis">🛣️  🎯 </div>
    <h1>অতিক্রান্ত দূরত্ব ও <span class="grad">সরণ</span></h1>
    <p class="sub">বস্তু মোট কতটুকু পথ চলল আর আদি–শেষ অবস্থানের সরলরৈখিক দূরত্ব কত — দুটো কি সবসময় এক? চলো সিমুলেশনে নিজের চোখে দেখি! 👇</p>
  </div>
</header>

<div class="wrap">

  <h2 class="section-title">📖 সংজ্ঞা দিয়ে শুরু করি</h2>
  <div class="defs">
    <div class="def" style="--c:var(--dist)">
      <h3>🛤️ অতিক্রান্ত দূরত্ব</h3>
      <p>নির্দিষ্ট সময়ে কোনো বস্তু <b>মোট যতটুকু পথ</b> অতিক্রম করে, তাকে তার অতিক্রান্ত দূরত্ব বলে। এটি পথের আকৃতির উপর নির্ভর করে।</p>
      <span class="tag">স্ক্যালার রাশি • একক: মিটার</span>
    </div>
    <div class="def" style="--c:var(--disp)">
      <h3>🎯 সরণ</h3>
      <p>নির্দিষ্ট দিকে বস্তুর <b>আদি ও শেষ অবস্থানের মধ্যবর্তী সরলরৈখিক দূরত্ব</b>-কে সরণ বলে। এটি শুধু শুরুর ও শেষের অবস্থানের উপর নির্ভর করে, পথের উপর নয়।</p>
      <span class="tag">ভেক্টর রাশি • একক: মিটার</span>
    </div>
  </div>

  <h2 class="section-title">🎬 সিমুলেশন ১ — বাড়ি থেকে স্কুলে যাওয়া (বাঁকা পথ বনাম সরলরেখা)</h2>
  <div class="card">
    <h3>✏️ রাস্তার বাঁক কমিয়ে-বাড়িয়ে দেখো, দূরত্ব ও সরণ কীভাবে বদলায়!</h3>
    <p class="hint">কমলা রেখা = অতিক্রান্ত দূরত্ব (মোট পথ) • সবুজ তীর = সরণ (সরলরৈখিক দূরত্ব)। স্লাইডারটি টেনে রাস্তা একদম সোজা করে দেখো কী হয়!</p>
    <div class="canvas-wrap"><canvas id="cv1"></canvas></div>
    <div class="legend">
      <span><i class="ld" style="background:var(--dist)"></i> অতিক্রান্ত দূরত্ব (পথ)</span>
      <span><i class="ld" style="background:var(--disp)"></i> সরণ (আদি → শেষ)</span>
    </div>
    <div class="sim-controls">
      <button id="play1" class="btn btn-amber">⏸ বিরতি</button>
      <button id="reset1" class="btn btn-slate">↺ রিসেট</button>
      <div class="slider-box">রাস্তার বাঁক
        <input type="range" id="curv" min="0" max="100" value="55">
      </div>
    </div>
    <div class="readouts">
      <div class="readout"><div class="lab">🛤️ অতিক্রান্ত দূরত্ব</div><div class="val amber" id="d1a">০ মি</div><div class="bar"><div class="fa" id="b1a"></div></div></div>
      <div class="readout"><div class="lab">🎯 সরণ</div><div class="val green" id="d1b">০ মি</div><div class="bar"><div class="fg" id="b1b"></div></div></div>
    </div>
  </div>

  <div class="grid2">
    <div class="card">
      <h3>🎡 সিমুলেশন ২ — বৃত্তাকার পথে ঘূর্ণন</h3>
      <p class="hint">r = ৭ মি ব্যাসার্ধের বৃত্তাকার পথে ঘুরছে। পূর্ণ ঘূর্ণনে সরণ কত হবে, ভেবে নাও!</p>
      <div class="canvas-wrap"><canvas id="cv2"></canvas></div>
      <div class="sim-controls">
        <button id="play2" class="btn btn-amber">⏸</button>
        <button id="reset2" class="btn btn-slate">↺</button>
        <button class="btn btn-green stepbtn" data-step="0.25">¼ ঘূর্ণন</button>
        <button class="btn btn-green stepbtn" data-step="0.5">½ ঘূর্ণন</button>
        <button class="btn btn-green stepbtn" data-step="0.75">¾ ঘূর্ণন</button>
        <button class="btn btn-green stepbtn" data-step="1">১ পূর্ণ</button>
      </div>
      <div class="readouts">
        <div class="readout"><div class="lab">🛤️ দূরত্ব</div><div class="val amber" id="d2a">০ মি</div><div class="bar"><div class="fa" id="b2a"></div></div></div>
        <div class="readout"><div class="lab">🎯 সরণ</div><div class="val green" id="d2b">০ মি</div><div class="bar"><div class="fg" id="b2b"></div></div></div>
      </div>
    </div>

    <div class="card">
      <h3>📐 সিমুলেশন ৩ — ৪০ মি পূর্ব + ৩০ মি উত্তর</h3>
      <p class="hint">দুই দিকে চললে দূরত্ব ও সরণ আলাদা হয় — পাইথাগোরাস দিয়ে সরণ মেপ দেখো!</p>
      <div class="canvas-wrap"><canvas id="cv3"></canvas></div>
      <div class="readouts">
        <div class="readout"><div class="lab">🛤️ দূরত্ব</div><div class="val amber" id="d3a">০ মি</div><div class="bar"><div class="fa" id="b3a"></div></div></div>
        <div class="readout"><div class="lab">🎯 সরণ</div><div class="val green" id="d3b">০ মি</div><div class="bar"><div class="fg" id="b3b"></div></div></div>
      </div>
    </div>
  </div>

  <h2 class="section-title">⚖️ দূরত্ব বনাম সরণ — এক নজরে</h2>
  <div class="th-card">
    <table>
      <thead><tr><th>বিষয়</th><th>অতিক্রান্ত দূরত্ব 🛤️</th><th>সরণ 🎯</th></tr></thead>
      <tbody>
        <tr><td>অর্থ</td><td class="c1">নির্দিষ্ট সময়ে বস্তু মোট যতটুকু পথ অতিক্রম করে</td><td class="c2">আদি ও শেষ অবস্থানের মধ্যবর্তী সরলরৈখিক দূরত্ব (নির্দিষ্ট দিকসহ)</td></tr>
        <tr><td>রাশির ধরন</td><td class="c1">স্ক্যালার রাশি</td><td class="c2">ভেক্টর রাশি</td></tr>
        <tr><td>মান</td><td class="c1">সর্বদা ধনাত্মক</td><td class="c2">ধনাত্মক, ঋণাত্মক বা শূন্য হতে পারে</td></tr>
        <tr><td>পথের উপর নির্ভরতা</td><td class="c1">পুরো পথের উপর নির্ভর করে</td><td class="c2">শুধু আদি ও শেষ অবস্থানের উপর নির্ভর করে</td></tr>
        <tr><td>একক</td><td class="c1">মিটার (m)</td><td class="c2">মিটার (m)</td></tr>
        <tr><td>সম্পর্ক</td><td class="c1">দূরত্ব ≥ সরণ</td><td class="c2">সরণ ≤ দূরত্ব</td></tr>
      </tbody>
    </table>
  </div>

  <div class="tips">
    <div class="tip">💡 বস্তু <b>সরলরেখা বরাবর এক দিকে</b> চললে: দূরত্ব = সরণ। (সিমুলেশন ১-এ স্লাইডার একদম বাঁয়ে নিয়ে দেখো!)</div>
    <div class="tip">💡 বস্তু ঘুরে <b>আবার শুরুতে ফিরে এলে</b>: সরণ = ০, কিন্তু দূরত্ব ≠ ০। (সিমুলেশন ২-এ "১ পূর্ণ" বাটনে চাপ দাও!)</div>
  </div>
</div>

<footer>🎓 শিক্ষার্থীদের জন্য তৈরি ইন্টারঅ্যাক্টিভ সিমুলেশন • বিজ্ঞান — গতি অধ্যায়<br>টিপ: স্লাইডার ও বাটনগুলো ব্যবহার করে শিক্ষার্থীদের আগে অনুমান করতে বলো, তারপর ফলাফল দেখাও!</footer>

<script>
(() => {
const bn=s=>String(s).replace(/[0-9]/g,d=>'০১৩৪৫৬৭৮৯'[d]);
const fmt=(x,d=0)=>bn(Number(x).toFixed(d));
const TAU=Math.PI*2;

function arrow(ctx,x1,y1,x2,y2,color,lw=3,head=10){
  const a=Math.atan2(y2-y1,x2-x1);
  ctx.strokeStyle=color;ctx.fillStyle=color;ctx.lineWidth=lw;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();
  ctx.beginPath();ctx.moveTo(x2,y2);
  ctx.lineTo(x2-head*Math.cos(a-0.42),y2-head*Math.sin(a-0.42));
  ctx.lineTo(x2-head*Math.cos(a+0.42),y2-head*Math.sin(a+0.42));
  ctx.closePath();ctx.fill();
}
function glowDot(ctx,x,y,r,c){ctx.save();ctx.shadowColor=c;ctx.shadowBlur=12;ctx.fillStyle=c;ctx.beginPath();ctx.arc(x,y,r,0,TAU);ctx.fill();ctx.restore();}
function label(ctx,t,x,y,c='#e8eeff',s=12.5){ctx.save();ctx.font=`600 ${s}px 'Hind Siliguri',sans-serif`;ctx.fillStyle=c;ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(t,x,y);ctx.restore();}
function lerp(a,b,f){return{x:a.x+(b.x-a.x)*f,y:a.y+(b.y-a.y)*f};}

function makeSim(id){const cv=document.getElementById(id);return{cv,ctx:cv.getContext('2d'),w:0,h:0};}
const S1=makeSim('cv1'),S2=makeSim('cv2'),S3=makeSim('cv3');

/* ================= সিমুলেশন ১ ================= */
let pts=[],cum=[],Lpx=0,abLen=1,A={x:0,y:0},B={x:0,y:0};
let curv=0.55,trav=0,run1=true,done1=false;
const MPP=()=>100/abLen;
const Lm=()=>Lpx*MPP();
function build1(){
  const w=S1.w,h=S1.h;if(w<10)return;
  A={x:w*0.10,y:h*0.76};B={x:w*0.90,y:h*0.28};
  const dx=B.x-A.x,dy=B.y-A.y;abLen=Math.hypot(dx,dy);
  const px=-dy/abLen,py=dx/abLen,amp=curv*h*0.34,N=240;
  pts=[];for(let i=0;i<=N;i++){
    const s=i/N,off=Math.sin(s*TAU)*amp*Math.sin(s*Math.PI);
    pts.push({x:A.x+dx*s+px*off,y:A.y+dy*s+py*off});
  }
  cum=[0];Lpx=0;
  for(let i=1;i<pts.length;i++){Lpx+=Math.hypot(pts[i].x-pts[i-1].x,pts[i].y-pts[i-1].y);cum.push(Lpx);}
}
function pos1(d){
  if(d<=0)return pts[0];if(d>=Lpx)return pts[pts.length-1];
  let lo=0,hi=cum.length-1;
  while(lo<hi){const m=(lo+hi)>>1;if(cum[m]<d)lo=m+1;else hi=m;}
  const seg=cum[lo]-cum[lo-1]||1,f=(d-cum[lo-1])/seg;
  return lerp(pts[lo-1],pts[lo],f);
}
const play1=document.getElementById('play1'),reset1=document.getElementById('reset1'),
curvR=document.getElementById('curv'),d1a=document.getElementById('d1a'),d1b=document.getElementById('d1b'),
b1a=document.getElementById('b1a'),b1b=document.getElementById('b1b');
function upPlay1(){play1.textContent=run1?'⏸ বিরতি':(done1?'▶ আবার চালু':'▶ চালু');}
play1.onclick=()=>{if(done1){trav=0;done1=false;run1=true;}else run1=!run1;upPlay1();};
reset1.onclick=()=>{trav=0;done1=false;run1=true;upPlay1();};
curvR.oninput=()=>{
  const f=Lm()?Math.min(1,trav/Lm()):0,wd=done1;
  curv=parseFloat(curvR.value)/100;build1();
  trav=f*Lm();if(wd){trav=Lm();}
};
function step1(dt){
  if(run1&&!done1){
    trav+=dt*36;
    if(trav>=Lm()){trav=Lm();done1=true;run1=false;upPlay1();}
  }
}
function draw1(){
  const{ctx,w,h}=S1;if(w<10)return;ctx.clearRect(0,0,w,h);
  ctx.fillStyle='rgba(148,163,184,.07)';
  for(let x=14;x<w;x+=26)for(let y=14;y<h;y+=26)ctx.fillRect(x,y,2,2);
  ctx.setLineDash([6,8]);ctx.strokeStyle='#33415e';ctx.lineWidth=2;
  ctx.beginPath();pts.forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));ctx.stroke();ctx.setLineDash([]);
  const d=trav/MPP(),p=pos1(d);
  ctx.strokeStyle='#f59e0b';ctx.lineWidth=4;ctx.lineCap='round';
  ctx.shadowColor='#f59e0b';ctx.shadowBlur=10;
  ctx.beginPath();ctx.moveTo(pts[0].x,pts[0].y);
  for(let i=1;i<pts.length&&cum[i]<=d;i++)ctx.lineTo(pts[i].x,pts[i].y);
  ctx.lineTo(p.x,p.y);ctx.stroke();ctx.shadowBlur=0;
  if(Math.hypot(p.x-A.x,p.y-A.y)>12){
    arrow(ctx,A.x,A.y,p.x,p.y,'#22c55e',3,10);
    label(ctx,'সরণ',(A.x+p.x)/2+16,(A.y+p.y)/2+18,'#4ade80',12.5);
  }
  ctx.font='22px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';
  ctx.fillText('🏠',A.x-22,A.y+4);ctx.fillText('🏫',B.x+22,B.y-2);
  glowDot(ctx,p.x,p.y,6,'#fbbf24');
  ctx.font='17px sans-serif';ctx.fillText('🚶',p.x,p.y-20);
  if(done1)label(ctx,`দূরত্ব ${fmt(Lm())} মি ≥ সরণ ১০০ মি`,w*0.5,h*0.94,'#e8eeff',14);
  else if(curv<0.02)label(ctx,'সরলরেখায় এক দিকে চললে: দূরত্ব = সরণ',w*0.5,h*0.94,'#4ade80',13);
  const disp=Math.hypot(p.x-A.x,p.y-A.y)*MPP();
  d1a.textContent=fmt(trav)+' মি';d1b.textContent=fmt(disp)+' মি';
  b1a.style.width=Math.min(100,trav/Lm()*100)+'%';
  b1b.style.width=Math.min(100,disp)+'%';
}

/* ================= সিমুলেশন ২ ================= */
let theta=0,run2=true,tgt2=null;
const RM=7;
const play2=document.getElementById('play2'),reset2=document.getElementById('reset2'),
d2a=document.getElementById('d2a'),d2b=document.getElementById('d2b'),
b2a=document.getElementById('b2a'),b2b=document.getElementById('b2b');
play2.onclick=()=>{if(theta>=TAU-1e-6)theta=0;run2=!run2;tgt2=null;play2.textContent=run2?'⏸':'▶';};
reset2.onclick=()=>{theta=0;tgt2=null;run2=true;play2.textContent='⏸';};
document.querySelectorAll('.stepbtn').forEach(b=>b.onclick=()=>{run2=false;play2.textContent='▶';tgt2=parseFloat(b.dataset.step)*TAU;});
function step2(dt){
  if(tgt2!=null){theta+=(tgt2-theta)*Math.min(1,dt*6);if(Math.abs(tgt2-theta)<0.002){theta=tgt2;tgt2=null;}}
  else if(run2){theta+=dt*0.75;if(theta>=TAU){theta=TAU;run2=false;play2.textContent='▶';}}
}
function draw2(){
  const{ctx,w,h}=S2;if(w<10)return;ctx.clearRect(0,0,w,h);
  const R=Math.min(w,h)*0.33,cx=w/2,cy=h*0.53;
  ctx.strokeStyle='#33415e';ctx.lineWidth=10;
  ctx.beginPath();ctx.arc(cx,cy,R,0,TAU);ctx.stroke();
  ctx.setLineDash([4,7]);ctx.strokeStyle='rgba(148,163,184,.35)';ctx.lineWidth=1.5;
  ctx.beginPath();ctx.arc(cx,cy,R,0,TAU);ctx.stroke();ctx.setLineDash([]);
  ctx.strokeStyle='rgba(148,163,184,.4)';ctx.lineWidth=1.5;
  ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(cx,cy-R);ctx.stroke();
  label(ctx,'r = ৭ মি',cx+34,cy-R*0.5,'#9db0d8',12);
  dotc(ctx,cx,cy,4,'#5b6c93');
  const S={x:cx,y:cy-R},a=-Math.PI/2+theta,P={x:cx+Math.cos(a)*R,y:cy+Math.sin(a)*R};
  if(theta>0.01){
    ctx.strokeStyle='#f59e0b';ctx.lineWidth=5;ctx.lineCap='round';
    ctx.shadowColor='#f59e0b';ctx.shadowBlur=10;
    ctx.beginPath();ctx.arc(cx,cy,R,-Math.PI/2,a);ctx.stroke();ctx.shadowBlur=0;
  }
  const disp=2*RM*Math.sin(theta/2);
  if(disp>0.15&&theta<TAU-1e-3){arrow(ctx,S.x,S.y,P.x,P.y,'#22c55e',3,10);
    label(ctx,'সরণ',(S.x+P.x)/2+((P.x>cx)?26:-26),(S.y+P.y)/2,'#4ade80',12.5);}
  glowDot(ctx,S.x,S.y,6,'#4ade80');label(ctx,'শুরু',S.x,S.y-18,'#4ade80',12);
  glowDot(ctx,P.x,P.y,6,'#fbbf24');
  ctx.font='17px sans-serif';ctx.textAlign='center';ctx.fillText('🏃',P.x,P.y-18);
  if(theta>=TAU-1e-3)label(ctx,'১ পূর্ণ ঘূর্ণন: দূরত্ব ৪৪ মি, কিন্তু সরণ = ০ !',w/2,h*0.08,'#fbbf24',14);
  d2a.textContent=fmt(RM*theta,1)+' মি';d2b.textContent=fmt(disp,1)+' মি';
  b2a.style.width=(theta/TAU*100)+'%';
  b2b.style.width=Math.min(100,disp/14*100)+'%';
}
function dotc(ctx,x,y,r,c){ctx.fillStyle=c;ctx.beginPath();ctx.arc(x,y,r,0,TAU);ctx.fill();}

/* ================= সিমুলেশন ৩ ================= */
let t3=0;
const d3a=document.getElementById('d3a'),d3b=document.getElementById('d3b'),
b3a=document.getElementById('b3a'),b3b=document.getElementById('b3b');
function step3(dt){t3+=dt;}
function draw3(){
  const{ctx,w,h}=S3;if(w<10)return;ctx.clearRect(0,0,w,h);
  const T1=2.2,T2=1.6,T3=1.7,tt=t3%(T1+T2+T3);
  const k=Math.min((w*0.66)/40,(h*0.60)/30);
  const O={x:w*0.17,y:h*0.80},E={x:O.x+40*k,y:O.y},N={x:E.x,y:E.y-30*k};
  let P,dist;
  if(tt<T1){const f=tt/T1;P=lerp(O,E,f);dist=40*f;}
  else if(tt<T1+T2){const f=(tt-T1)/T2;P=lerp(E,N,f);dist=40+30*f;}
  else{P=N;dist=70;}
  const dispM=Math.hypot(P.x-O.x,P.y-O.y)/k;
  ctx.setLineDash([6,8]);ctx.strokeStyle='#33415e';ctx.lineWidth=2;
  ctx.beginPath();ctx.moveTo(O.x,O.y);ctx.lineTo(E.x,E.y);ctx.lineTo(N.x,N.y);ctx.stroke();ctx.setLineDash([]);
  ctx.strokeStyle='#f59e0b';ctx.lineWidth=4;ctx.lineCap='round';
  ctx.shadowColor='#f59e0b';ctx.shadowBlur=10;
  ctx.beginPath();ctx.moveTo(O.x,O.y);
  if(tt<T1)ctx.lineTo(P.x,P.y);
  else{ctx.lineTo(E.x,E.y);ctx.lineTo(P.x,P.y);}
  ctx.stroke();ctx.shadowBlur=0;
  if(tt>=T1){ctx.strokeStyle='#4ade80';ctx.lineWidth=2;
    ctx.strokeRect(E.x-12,E.y-12,12,12);}
  label(ctx,'৪০ মি',(O.x+E.x)/2,O.y+20,'#fbbf24',12.5);
  label(ctx,'৩০ মি',E.x+34,(E.y+N.y)/2,'#fbbf24',12.5);
  if(tt>=T1+T2){
    arrow(ctx,O.x,O.y,N.x,N.y,'#22c55e',3,10);
    label(ctx,'সরণ = ৫০ মি',(O.x+N.x)/2-46,(O.y+N.y)/2,'#4ade80',13);
    label(ctx,'দূরত্ব ৭০ মি > সরণ ৫০ মি',w/2,h*0.09,'#e8eeff',13.5);
  }
  glowDot(ctx,O.x,O.y,5,'#4ade80');
  glowDot(ctx,P.x,P.y,6,'#fbbf24');
  ctx.font='17px sans-serif';ctx.textAlign='center';ctx.fillText('🚶',P.x,P.y-20);
  d3a.textContent=fmt(dist)+' মি';d3b.textContent=fmt(dispM)+' মি';
  b3a.style.width=(dist/70*100)+'%';b3b.style.width=(dispM/50*100)+'%';
}

/* ================= লুপ ও রিসাইজ ================= */
function resize(){
  const dpr=devicePixelRatio||1;
  [S1,S2,S3].forEach(s=>{
    const r=s.cv.getBoundingClientRect();
    if(r.width<10)return;
    s.w=r.width;s.h=r.height;
    s.cv.width=Math.round(r.width*dpr);s.cv.height=Math.round(r.height*dpr);
    s.ctx.setTransform(dpr,0,0,dpr,0,0);
  });
  build1();
}
addEventListener('resize',resize);
resize();requestAnimationFrame(resize);
let last=performance.now();
function frame(now){
  const dt=Math.min((now-last)/1000,.05);last=now;
  step1(dt);draw1();step2(dt);draw2();step3(dt);draw3();
  requestAnimationFrame(frame);
}
requestAnimationFrame(t=>{last=t;frame(t);});
})();
</script>
</body>
