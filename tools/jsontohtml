            border: none;
            transition: var(--transition);
            font-family: var(--font-bn);
            letter-spacing: 0.1px;
            white-space: nowrap;
        }
        .btn-primary {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 4px 16px rgba(26, 122, 92, 0.25);
        }
        .btn-primary:hover {
            background: var(--primary-hover);
            box-shadow: 0 6px 22px rgba(26, 122, 92, 0.35);
            transform: translateY(-1px);
        }
        .btn-primary:active {
            transform: translateY(0);
            box-shadow: 0 2px 10px rgba(26, 122, 92, 0.2);
        }
        .btn-outline {
            background: #fff;
            color: var(--text);
            border: 2px solid #d5cdbd;
        }
        .btn-outline:hover {
            border-color: #b0a590;
            background: #fafaf7;
        }
        .btn-sm {
            padding: 8px 16px;
            font-size: 0.82rem;
            border-radius: 30px;
        }
        .btn-accent {
            background: var(--accent);
            color: #fff;
            box-shadow: 0 4px 14px rgba(232, 131, 58, 0.2);
        }
        .btn-accent:hover {
            background: var(--accent-hover);
            box-shadow: 0 6px 20px rgba(232, 131, 58, 0.3);
            transform: translateY(-1px);
        }
        .btn:disabled {
            opacity: 0.55;
            cursor: not-allowed;
            pointer-events: none;
        }

        .summary-card {
            background: #f9faf7;
            border: 1px solid #e6e0d4;
            border-radius: var(--radius-sm);
            padding: 18px 22px;
            margin-bottom: 10px;
            display: none;
            animation: fadeSlideIn 0.4s ease;
