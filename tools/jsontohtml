        textarea {
            width: 100%;
            height: 340px;
            border: 2px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 16px 18px;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            line-height: 1.55;
